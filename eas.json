{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "environment": "development",
      "prebuildCommand": "cd ios && pod install"
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "prebuildCommand": "cd ios && pod install"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "prebuildCommand": "cd ios && pod install"
    }
  },
  "submit": {
    "production": {}
  }
}
