{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "environment": "development"
    },
    "preview": {
      "distribution": "store",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "image": "macos-sonoma-14.4-xcode-15.4"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
