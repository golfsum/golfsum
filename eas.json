{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "environment": "development",
      "ios": {
        "image": "latest",
        "buildConfiguration": "Debug",
        "prebuildCommand": "npx expo prebuild --platform ios --clean && ruby scripts/add_watch_target.rb"
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release",
        "prebuildCommand": "npx expo prebuild --platform ios --clean && ruby scripts/add_watch_target.rb"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release",
        "prebuildCommand": "npx expo prebuild --platform ios --clean && ruby scripts/add_watch_target.rb"
      }
    }
  },
  "submit": {
    "production": {}
  }
}