{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "environment": "development",
      "ios": {
        "image": "macos-sequoia-15.2-xcode-16.2",
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "ios": {
        "image": "macos-sequoia-15.2-xcode-16.2",
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.2-xcode-16.2",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}